{
  "name": "wfcd-name-forge",
  "productName": "Warframe Name Generator",
  "version": "1.0.0",
  "description": "A simple Electron app to make Warframe names",
  "main": "src/index.js",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WFCD/wfcd-name-forge.git"
  },
  "scripts": {
    "start": "npx electron-forge start",
    "package": "npx electron-forge package",
    "make": "npx electron-forge make",
    "publish": "npx electron-forge publish",
    "lint": "npx eslint src .config test --color --config .config/eslint.config.mjs",
    "lint:fix": "npx eslint src .config test --color --fix --config .config/eslint.config.mjs",
    "pinact": "pinact -c .config/pinact.yaml run",
    "prepare": "husky",
    "release": "npx semantic-release",
    "test": "xvfb-maybe npx playwright test --config .config/playwright.config.js"
  },
  "keywords": [],
  "author": "TobiTenno",
  "license": "MIT",
  "release": {
    "extends": "./.config/release.config.js"
  },
  "config": {
    "forge": "./.config/forge.config.js"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "tar": "^7.5.22",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "tmp": "^0.2.7"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "electron-squirrel-startup": "^1.0.1",
    "materialize-css": "^1.0.0",
    "warframe-name-generator": "^2.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@semantic-release/exec": "^7.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "electron": "^44.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.3.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "semantic-release": "^25.0.9",
    "xvfb-maybe": "^0.2.1"
  }
}
